<Window x:Class="USBGuardian.App.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:USBGuardian.App.UI"
        Width="416" Height="204" MinWidth="340"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI Variable, Microsoft JhengHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="ToastButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ui:ContinuousBorder x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ui:ContinuousBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ui:ContinuousBorder x:Name="ToastFrame" Background="{DynamicResource ToastBackgroundBrush}"
            BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1" CornerRadius="20" Margin="7">
        <Border.Effect>
            <DropShadowEffect Color="#000000" ShadowDepth="3" BlurRadius="18" Opacity="0.16"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ContinuousBorder x:Name="ToastSignal" Grid.Column="0" Background="{DynamicResource AccentBrush}"
                    Visibility="Collapsed" CornerRadius="4,0,0,4"/>
            <Grid Grid.Column="1" Margin="18,15,17,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ContinuousBorder x:Name="LevelIconBackground" Background="{DynamicResource NotificationInfoTintBrush}"
                                Width="32" Height="32" CornerRadius="11" Margin="0,0,10,0">
                            <TextBlock x:Name="LevelIcon" Text="i" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource NotificationInfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ui:ContinuousBorder>
                        <TextBlock Text="USB Guardian" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LevelText" Text="資訊" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="DismissButton" Grid.Column="1" Width="28" Height="28"
                            Content="×" FontSize="18" Padding="0"
                            BorderThickness="0" Background="Transparent"
                            Foreground="{DynamicResource MutedTextBrush}" Cursor="Hand"
                            Click="Dismiss_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="SubtitleText" Margin="0,10,0,7"
                           Text="USB 裝置通知" FontSize="16.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="46"/>
                <!-- The body must never be silently clipped. On long notices the mouse wheel
                     scrolls this area; the details button opens the complete saved event. -->
                <ScrollViewer x:Name="ToastBodyScroll" Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" CanContentScroll="False"
                              Focusable="True" Margin="0,0,0,0">
                    <TextBlock x:Name="BodyText" Text="裝置狀態更新"
                               FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="ScanButton" Content="Defender 掃描" Style="{StaticResource ToastButton}"
                            Background="{DynamicResource SoftButtonBrush}"
                            Foreground="{DynamicResource SoftButtonTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Margin="0,0,7,0" Click="Scan_Click"/>
                    <Button x:Name="OpenButton" Content="查看詳情" Style="{StaticResource ToastButton}"
                            Foreground="White" Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" Click="Open_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ui:ContinuousBorder>
</Window>
