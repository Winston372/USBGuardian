<Window x:Class="USBGuardian.App.UI.UsageNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:USBGuardian.App.UI"
        Title="USB Guardian｜使用須知與風險說明" Icon="/USBGuardian.App;component/Assets/USBGuardian.ico"
        Width="820" Height="710" MinWidth="620" MinHeight="550" SnapsToDevicePixels="True" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft JhengHei UI"
        ShowInTaskbar="True">
    <Grid Margin="30,25,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="HeadingText" Text="使用須知與風險說明"
                       FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="IntroText" Visibility="Collapsed"
                       Text="請閱讀完整內容，確認了解重要限制後再開始使用。"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
            <ui:ContinuousBorder Visibility="Collapsed" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="13,11" CornerRadius="12" Margin="0,16,0,0">
                <TextBlock x:Name="QuickSummaryText" TextWrapping="Wrap" FontSize="12"
                           LineHeight="21" Text="USB Guardian 提供接入後提醒，不保證事前攔截或偵測所有威脅。重要操作需自行確認，並請事先備份檔案。"/>
            </ui:ContinuousBorder>
        </StackPanel>
        <ui:ContinuousBorder Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="14">
            <ScrollViewer x:Name="NoticeScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="True"
                          ScrollChanged="NoticeScroll_Changed" Loaded="NoticeScroll_Loaded"
                          Padding="20,18">
                <TextBlock x:Name="NoticeBody" TextWrapping="Wrap"
                           FontFamily="Segoe UI, Microsoft JhengHei UI"
                           FontSize="13" LineHeight="22"
                           Foreground="{DynamicResource TextBrush}"/>
            </ScrollViewer>
        </ui:ContinuousBorder>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ReadProgressText" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,11"
                       Text="請將文件捲動至底部，才能勾選同意。"/>
            <CheckBox x:Name="ConsentCheck" IsEnabled="False" AutomationProperties.HelpText="Read the document to the end to enable this control"
                      Checked="ConsentChanged" Unchecked="ConsentChanged" Margin="0,0,0,15">
                <TextBlock x:Name="ConsentLabel" Text="我已閱讀並理解使用限制、資料處理方式與操作風險，且同意繼續使用。"
                           Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
            </CheckBox>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="DeclineButton" Grid.Column="0" HorizontalAlignment="Left" Padding="17,9"
                        Background="{DynamicResource SoftButtonBrush}"
                        Foreground="{DynamicResource SoftButtonTextBrush}" BorderThickness="0"
                        Content="不同意並結束" Click="Decline_Click"/>
                <Button x:Name="AcceptButton" Grid.Column="1" Padding="19,9"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                        Content="同意並開始使用" IsEnabled="False" Click="Accept_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
