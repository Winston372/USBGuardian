<Window x:Class="USBGuardian.App.UI.ReportIssueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:USBGuardian.App.UI"
        Title="回報問題 · USB Guardian" Icon="pack://application:,,,/Assets/USBGuardian.ico"
        Width="590" Height="668" MinWidth="490" MinHeight="490"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable, Microsoft JhengHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="FieldTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ui:ContinuousBorder x:Name="FieldFrame" Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </ui:ContinuousBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SoftButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SoftButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ui:ContinuousBorder x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ui:ContinuousBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <Style x:Key="GuardianComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <ui:ContinuousBorder x:Name="ItemBg" Background="Transparent" CornerRadius="9" Margin="3,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </ui:ContinuousBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SoftButtonBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource GuardianComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ui:ContinuousBorder x:Name="Chrome" Background="{DynamicResource InputBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" IsHitTestVisible="False" Margin="0,0,10,0"
                                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    TextElement.Foreground="{DynamicResource TextBrush}"/>
                                                <Path Grid.Column="1" Width="10" Height="6" Stretch="Fill"
                                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5"
                                                      Data="M 0 0 L 5 5 L 10 0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ui:ContinuousBorder>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   StaysOpen="False" PopupAnimation="Fade" Focusable="False">
                                <ui:ContinuousBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,2,0,5"
                                        MinWidth="{Binding ActualWidth, ElementName=DropToggle}">
                                    <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </ui:ContinuousBorder>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="26,24,26,15">
            <TextBlock x:Name="Heading" Text="回報問題" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="Introduction" Text="告訴我們發生了什麼事。" Margin="0,7,0,0"
                FontSize="14" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0" CanContentScroll="False">
            <StackPanel Margin="26,0,26,20">
                <TextBlock x:Name="TypeLabel" Text="問題類型" Style="{StaticResource FieldTitle}"/>
                <ComboBox x:Name="CategoryChoice" Height="42" Margin="0,0,0,18" FontSize="14"
                          Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" Padding="10,8"/>
                <TextBlock x:Name="SummaryLabel" Text="問題簡述 *" Style="{StaticResource FieldTitle}"/>
                <TextBox x:Name="SummaryInput" Style="{StaticResource FormInput}" MaxLength="120" Margin="0,0,0,17"
                         AutomationProperties.Name="問題簡述"/>
                <TextBlock x:Name="WhatLabel" Text="發生了什麼事？ *" Style="{StaticResource FieldTitle}"/>
                <TextBox x:Name="DescriptionInput" Style="{StaticResource FormInput}" Height="100" MinHeight="95"
                         Margin="0,0,0,17" MaxLength="3200" AcceptsReturn="True" VerticalContentAlignment="Top"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="發生了什麼事"/>
                <TextBlock x:Name="StepsLabel" Text="如何再次遇到這個問題？（選填）" Style="{StaticResource FieldTitle}"/>
                <TextBox x:Name="StepsInput" Style="{StaticResource FormInput}" Height="84" Margin="0,0,0,17"
                         MaxLength="1600" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="重現步驟"/>
                <TextBlock x:Name="EmailLabel" Text="你的聯絡信箱（選填）" Style="{StaticResource FieldTitle}"/>
                <TextBox x:Name="EmailInput" Style="{StaticResource FormInput}" MaxLength="180" Margin="0,0,0,15"
                         AutomationProperties.Name="聯絡信箱"/>
                <CheckBox x:Name="IncludeDiagnostics" Margin="0,0,0,9" FontSize="13.5"
                    Foreground="{DynamicResource TextBrush}" Content="附上程式版本與錯誤摘要（選填）"/>
                <TextBlock x:Name="PrivacyNote" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}"
                    TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,2"
                    Text="送出前請檢查內容。請勿提供密碼、金鑰或私人檔案。需要截圖時，可自行附在郵件中。"/>
            </StackPanel>
        </ScrollViewer>
        <ui:ContinuousBorder Grid.Row="2" CornerRadius="0" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}" Padding="22,15">
            <DockPanel LastChildFill="False">
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Click="Cancel_Click"
                        Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
                <Button x:Name="ComposeButton" DockPanel.Dock="Right" Content="開啟郵件草稿" Click="Compose_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}"
                        Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="複製內容" Click="Copy_Click"
                        Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
            </DockPanel>
        </ui:ContinuousBorder>
    </Grid>
</Window>
