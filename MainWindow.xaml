                            <ui:ContinuousBorder Background="{DynamicResource SubtleBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="1" CornerRadius="16" Padding="18,15" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Ui351DeviceStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"/>
                                    <TextBlock x:Name="ActionStatusHeadline" Text="{DynamicResource Ui351StatusReady}"
                                               FontSize="18" FontWeight="SemiBold" Margin="0,6,0,5" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ActionDeviceContextText" Text="{DynamicResource Ui351EmptyState}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ActionStatusNote" Text="" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ui:ContinuousBorder>
                            <TextBlock Text="{DynamicResource Ui351DeviceControlGuide}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12" Margin="0,0,0,12"/>
                            <ui:ContinuousBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="1" CornerRadius="14" Padding="17,15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ui351ReminderTitle}" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="{DynamicResource Ui351ReminderDesc}" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="MarkAttentionActionButton" Grid.Column="1" Content="{DynamicResource Ui351ReminderAction}"
                                            Style="{StaticResource SoftButton}" Click="MarkUntrusted_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:ContinuousBorder>
                            <ui:ContinuousBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="1" CornerRadius="14" Padding="17,15" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ui351DisableTitle}" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="{DynamicResource Ui351DisableDesc}" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="DisableStorageActionButton" Grid.Column="1" Content="{DynamicResource Ui351DisableAction}"
                                            Style="{StaticResource PrimaryButton}" Click="DisableUsbStorage_Click" VerticalAlignment="Center"
                                            IsEnabled="False"/>
                                </Grid>
                            </ui:ContinuousBorder>
                            <Expander Header="{DynamicResource Ui351MoreActions}" IsExpanded="False" Margin="0,10,0,0"
                                      Foreground="{DynamicResource TextBrush}" FontSize="13">
                                <ui:ContinuousBorder Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui351OtherHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <TextBlock Text="{DynamicResource UiDevNicknameLabel}" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBox x:Name="NicknameBox" Style="{StaticResource RoundedInput}" Height="36" Padding="10,7" Margin="0,0,0,10" ToolTip="{DynamicResource Ui088}"/>
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Content="{DynamicResource Ui087}" Style="{StaticResource SoftButton}" Click="MarkFamiliar_Click" Margin="0,0,8,8"/>
                                            <Button Content="{DynamicResource Ui086}" Style="{StaticResource SoftButton}" Click="UnmarkFamiliar_Click" Margin="0,0,8,8"/>
                                            <Button Content="{DynamicResource Ui090}" Style="{StaticResource SoftButton}" Click="ClearUntrusted_Click" Margin="0,0,8,8"/>
                                            <Button Content="{DynamicResource Ui085}" Style="{StaticResource SoftButton}" Click="ExportReport_Click" Margin="0,0,8,8"/>
                                            <Button Content="{DynamicResource UiChooseFromDevices}" Style="{StaticResource SoftButton}" Click="NavigateToDevices_Click" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                        <Separator Margin="0,0,0,13"/>
                                        <TextBlock Text="{DynamicResource Ui351RecoveryTitle}" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <ComboBox x:Name="DisabledStorageCombo" Width="280" Height="38" Margin="0,0,10,8"/>
                                            <Button Content="{DynamicResource Ui093}" Click="EnableUsbStorage_Click"
                                                    Style="{StaticResource SoftButton}" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <TextBlock Text="{DynamicResource Ui351NotSupported}" FontSize="11.5"
                                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </ui:ContinuousBorder>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- Activity: actual desktop work area, two lists, inline command bars, zero dashboard cards. -->
                <TabItem Header="{DynamicResource Ui009}">
                  <Grid Margin="0,0,0,3">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="3*" MinHeight="165"/>
                      <RowDefinition Height="12"/>
                      <RowDefinition Height="2*" MinHeight="138"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Ui096}"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <!-- Alerts: title + short description on the left; actions in a compact toolbar. -->
                    <Grid Grid.Row="1">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource UiAlertCenter}" Style="{StaticResource SectionHeading}"/>
                          <TextBlock x:Name="AlertSummaryText" Text="" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                          <Button Content="{DynamicResource UiReviewAlert}" Click="ReviewAlert_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                          <Button Content="{DynamicResource UiMarkRead}" Click="MarkAlertRead_Click" Style="{StaticResource SoftButton}"/>
                        </StackPanel>
                      </Grid>
                      <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="190"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*" MinWidth="170"/></Grid.ColumnDefinitions>
                        <ui:ContinuousBorder Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                          <ListBox x:Name="AlertList" BorderThickness="0" FontSize="12.5" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   SelectionChanged="AlertList_SelectionChanged"/>
                        </ui:ContinuousBorder>
                        <ui:ContinuousBorder Grid.Column="2" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                          <!-- Full notification text remains readable even when it spans many lines. -->
                          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                        PanningMode="VerticalOnly" CanContentScroll="False">
                            <StackPanel>
                              <TextBlock Text="{DynamicResource UiEventDetailHeader}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,9"/>
                              <TextBlock x:Name="AlertSelectedTitle" Text="{DynamicResource UiSelectAlert}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                              <TextBlock x:Name="AlertSelectedInfo" Text="" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,9"/>
                              <TextBlock x:Name="AlertSelectedBody" Text="" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                          </ScrollViewer>
                        </ui:ContinuousBorder>
                      </Grid>
                    </Grid>
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  />
                    <!-- Quarantine: an ordinary list with a recover action, no oversized empty-state icon. -->
                    <Grid Grid.Row="3">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource UiQuarantineTitle}" Style="{StaticResource SectionHeading}"/>
                          <TextBlock x:Name="QuarantineSummaryText" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                          <Button Content="{DynamicResource UiRestoreQuarantine}" Click="RestoreQuarantine_Click" Style="{StaticResource SoftButton}" Margin="0,0,7,0"/>
                          <Button Content="{DynamicResource UiDeleteQuarantine}" Click="RemoveQuarantine_Click" Style="{StaticResource SoftButton}" Margin="0,0,7,0"/>
                          <Button Content="{DynamicResource UiRefreshQuarantine}" Click="RefreshQuarantine_Click" Style="{StaticResource SoftButton}"/>
                        </WrapPanel>
                      </Grid>
                      <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
                        <ListBox x:Name="QuarantineList" BorderThickness="0" FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                      </Border>
                    </Grid>
                    <Expander Grid.Row="4" x:Name="TechnicalLogExpander" Header="{DynamicResource UiTechnicalLog}" IsExpanded="False" FontSize="12" Margin="0,12,0,0">
                      <Grid Margin="0,8,0,0" Height="204">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <ui:ContinuousBorder Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                          <ListBox x:Name="LogList" BorderThickness="0" FontSize="12" SelectionChanged="LogList_SelectionChanged"/>
                        </ui:ContinuousBorder>
                        <ui:ContinuousBorder Grid.Column="2" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                          <StackPanel>
                            <TextBlock Text="{DynamicResource UiEventDetailHeader}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock x:Name="LogDetailTitle" Text="{DynamicResource UiEventClickHint}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,5" FontSize="13"/>
                            <TextBlock x:Name="LogDetailInfo" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,9"/>
                            <TextBlock x:Name="LogDetailBody" Text="" TextWrapping="Wrap" FontSize="12"/>
                          </StackPanel>
                        </ui:ContinuousBorder>
                      </Grid>
                    </Expander>
                  </Grid>
                </TabItem>
<TabItem Header="{DynamicResource Ui010}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="0,2,0,8" MaxWidth="680" HorizontalAlignment="Stretch">
  <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="{DynamicResource Ui097}" Style="{StaticResource SettingsSectionTitle}"/>
    <TextBlock Text="{DynamicResource Ui098}" Style="{StaticResource SettingsFieldLabel}"/>
    <ComboBox x:Name="ThemeChoice" Height="42" FontSize="14.5" FontWeight="Medium" Margin="0,0,0,19" SelectionChanged="ThemeChoice_SelectionChanged">
     <ComboBoxItem Tag="system" Content="{DynamicResource Ui099}"/><ComboBoxItem Tag="light" Content="{DynamicResource Ui100}"/><ComboBoxItem Tag="dark" Content="{DynamicResource Ui101}"/>
    </ComboBox>
    <TextBlock Text="{DynamicResource Ui102}" Style="{StaticResource SettingsFieldLabel}"/>
    <ComboBox x:Name="LanguageChoice" Height="42" FontSize="14.5" FontWeight="Medium" SelectionChanged="LanguageChoice_SelectionChanged">
     <ComboBoxItem Tag="zh-TW" Content="{DynamicResource Ui103}"/><ComboBoxItem Tag="en" Content="English"/>
    </ComboBox>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="{DynamicResource Ui104}" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
    <CheckBox x:Name="StartupCheck" Content="{DynamicResource Ui105}" Checked="StartupChanged" Unchecked="StartupChanged" FontSize="12"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Panel}">
   <StackPanel>
    <TextBlock Text="{DynamicResource Ui107}" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>
    <WrapPanel>
     <Button Content="{DynamicResource Ui108}" Click="OpenUsageNotice_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/>
     <Button Content="{DynamicResource Ui109}" Click="ShowResourceUsage_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/>
    </WrapPanel>
    <Expander Header="{DynamicResource UiNotificationTools}" Margin="0,5,0,0" IsExpanded="False" FontSize="12" Foreground="{DynamicResource TextBrush}">
      <WrapPanel Margin="0,9,0,0">
        <Button Content="{DynamicResource Ui110}" Click="TestNotification_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/>
        <Button Content="{DynamicResource UiToastTestCaution}" Click="TestCautionNotification_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/>
        <Button Content="{DynamicResource UiToastTestCritical}" Click="TestCriticalNotification_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/>
        <Button Content="{DynamicResource Ui352TestLong}" Click="TestLongNotification_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/>
        <Button Content="{DynamicResource UiTestReport}" Click="TestIssueReport_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/>
      </WrapPanel>
    </Expander>

   </StackPanel>
  </Border>
 </StackPanel>
</ScrollViewer></TabItem></TabControl>
        </Grid>
    </Grid>
</Window>
