<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:USBGuardian.App.UI" x:Class="USBGuardian.App.MainWindow" Title="USB Guardian" Icon="Assets/USBGuardian.ico" Width="1100" Height="745" MinWidth="880" MinHeight="620" SnapsToDevicePixels="True" UseLayoutRounding="True" FontSize="13" WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI Variable, Microsoft JhengHei UI, Segoe UI" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- V3.5.8: remove the global Expander/TreeViewItem templates introduced in 3.5.7.
             Native WPF templates retain correct disclosure and keyboard behavior.
             Explicit foreground settings on affected Expanders remain in place. -->
        <SolidColorBrush x:Key="Ink" Color="#1B2942"/>
        <SolidColorBrush x:Key="Muted" Color="#687993"/>
        <SolidColorBrush x:Key="Accent" Color="#2171E5"/>
        <SolidColorBrush x:Key="Line" Color="#E0E7F1"/>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <ui:ContinuousBorder x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ui:ContinuousBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/><Setter TargetName="Bg" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SoftButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource SoftButtonTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SoftButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="Button" x:Key="HomeQuickAction" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- Flat sections with a hairline divider: no dashboard cards or floating shadows. -->
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="15,14"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeading">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ui:ContinuousBorder x:Name="NavBg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </ui:ContinuousBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBg" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Native, compact list rows shared by History, Recent activity, and Quarantine. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="1,1,1,2"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ui:ContinuousBorder x:Name="RowSurface" Background="Transparent" CornerRadius="7"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </ui:ContinuousBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Keep the native WPF tree template for safe startup; theme its inherited text and selection brushes. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Readable settings labels: never inherit the system's low-contrast foreground. -->
        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,17"/>
        </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
<Style x:Key="RoundedInput" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ui:ContinuousBorder x:Name="InputFrame" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
          </ui:ContinuousBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="InputFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputFrame" Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
</Style>


        <!-- Theme-aware WPF ComboBox, including the dropdown popup and selection. -->
        <Style x:Key="GuardianComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <ui:ContinuousBorder x:Name="ItemBg" Background="Transparent" CornerRadius="9" Margin="3,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </ui:ContinuousBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SoftButtonBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource GuardianComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ui:ContinuousBorder x:Name="Chrome" Background="{DynamicResource InputBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" IsHitTestVisible="False" Margin="0,0,10,0"
                                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    TextElement.Foreground="{DynamicResource TextBrush}"/>
                                                <Path Grid.Column="1" Width="10" Height="6" Stretch="Fill"
                                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5"
                                                      Data="M 0 0 L 5 5 L 10 0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ui:ContinuousBorder>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   StaysOpen="False" PopupAnimation="Fade" Focusable="False">
                                <ui:ContinuousBorder Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,2,0,5"
                                        MinWidth="{Binding ActualWidth, ElementName=DropToggle}">
                                    <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </ui:ContinuousBorder>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<Style TargetType="TreeView"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
</Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="9,17,9,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="9,0,0,23">
                    <Image Width="27" Height="27" Source="Assets/USBGuardian.png" Margin="0,0,10,0" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="USB Guardian" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Ui001}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/></StackPanel>
                </StackPanel>
                <!-- The colored point reports notification/monitoring status, not a malware verdict. -->
                <StackPanel Grid.Row="1" Margin="11,0,7,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTipService.InitialShowDelay="280" ToolTipService.ShowDuration="15000">
                        <StackPanel.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="280" Margin="4">
                                    <TextBlock x:Name="MonitorTooltipTitle" FontWeight="SemiBold" Text="監控中" FontSize="13"/>
                                    <TextBlock x:Name="MonitorTooltipDetails" Text="USB 插入通知已啟用" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
                                </StackPanel>
                            </ToolTip>
                        </StackPanel.ToolTip>
                        <Ellipse x:Name="MonitoringStatusDot" Width="8" Height="8" Fill="#249B73" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Ui003}" x:Name="SidebarStatus" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,2,0,0" x:Name="SidebarNavPanel">
                    
                    <Button Tag="0" Style="{StaticResource NavButton}" Click="NavigateSidebar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,11 L 12,3 L 21,11 M 6,10 L 6,21 L 18,21 L 18,10 M 10,21 L 10,15 L 14,15 L 14,21" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Ui006}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="1" Style="{StaticResource NavButton}" Click="NavigateSidebar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 4,5 L 8,5 L 10,8 L 20,8 L 20,19 L 4,19 Z M 4,10 L 20,10" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Ui007}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="2" Style="{StaticResource NavButton}" Click="NavigateSidebar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 6,3 L 6,10 M 18,3 L 18,10 M 3,10 L 21,10 L 21,18 L 16,18 L 16,21 L 8,21 L 8,18 L 3,18 Z" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Ui008}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="3" Style="{StaticResource NavButton}" Click="NavigateSidebar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18 M 9,3 L 9,9 M 16,9 L 16,15 M 7,15 L 7,21" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource UiDeviceActionsTab}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="4" Style="{StaticResource NavButton}" Click="NavigateSidebar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12,3 C 7,3 3,7 3,12 C 3,17 7,21 12,21 C 17,21 21,17 21,12 C 21,7 17,3 12,3 Z M 12,7 L 12,12 L 16,14" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Ui009}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="5" Style="{StaticResource NavButton}" Click="NavigateSidebar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12,3 L 14,5 L 17,4 L 18,7 L 21,8 L 20,11 L 21,14 L 18,16 L 17,19 L 14,19 L 12,21 L 10,19 L 7,19 L 6,16 L 3,14 L 4,11 L 3,8 L 6,7 L 7,4 L 10,5 Z M 12,9 C 10,9 9,10 9,12 C 9,14 10,15 12,15 C 14,15 15,14 15,12 C 15,10 14,9 12,9 Z" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Ui010}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="4,0,4,0">
                    <!-- Persistent support entry. Does not create or send a report until selected. -->
                    <Button x:Name="ReportIssueButton" Click="ReportProblem_Click" Height="40" Margin="0,0,0,12"
                            ToolTip="回報問題 / Report a problem" AutomationProperties.Name="回報問題 / Report a problem"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left" Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,5 Q 3,3 5,3 L 19,3 Q 21,3 21,5 L 21,15 Q 21,17 19,17 L 10,17 L 5,21 L 5,17 Q 3,17 3,15 Z M 12,7 L 12,11 M 12,14 L 12,14.2"
                                  Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.65" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource UiReportProblem}" FontSize="13.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="USB Guardian" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="10,0,0,0"/>
                    <TextBlock Text="{DynamicResource Ui011}" Foreground="{DynamicResource MutedTextBrush}" Margin="10,5,0,0" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Margin="0" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="24,22,24,11">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CurrentPageHeading" Text="USB Guardian" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="CurrentPageSubtitle" Text="{DynamicResource Ui012}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

            </Grid>
            <Border Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource SubtleBrush}" Padding="24,8,24,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#219572" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Ui013}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource Ui014}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <!-- Left navigation is the only navigation. Tab headers are hidden intentionally. -->
            <TabControl x:Name="MainTabs" Grid.Row="2" Margin="24,16,24,8" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <!-- Home: conventional utility overview, not a promotional hero/card stack. -->
                <TabItem Header="{DynamicResource Ui006}">
                  <Grid Margin="0,0,0,2">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*" MinHeight="165"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,20" Margin="0,0,0,16">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                          <TextBlock Text="{DynamicResource Ui015}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"/>
                          <TextBlock x:Name="HomeHeadlineText" Text="{DynamicResource Ui016}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,5"/>
                          <TextBlock x:Name="HomeAdviceText" Visibility="Collapsed" Text="{DynamicResource Ui017}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="{DynamicResource Ui007}" Click="HomeInspect_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                          <Button Content="{DynamicResource Ui018}" Click="HomeDevices_Click" Style="{StaticResource SoftButton}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Ui351HomeHint}" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                    <!-- Human-readable event rows. Primary actions appear on hover/keyboard focus. -->
                    <Grid Grid.Row="2">
